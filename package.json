{
  "name": "open-lyric-plugin-km-kh",
  "version": "0.1.15",
  "description": "Khmer (km-KH) support for Open Lyric: NiDA on-screen keyboard, Hunspell spellcheck, segmentation, and Khmer-capable fonts.",
  "license": "MIT",
  "author": "raksa <eng.raksa@gmail.com>",
  "homepage": "https://github.com/raksa/open-lyric-plugin-km-kh-dist#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raksa/open-lyric-plugin-km-kh-dist.git"
  },
  "bugs": {
    "url": "https://github.com/raksa/open-lyric-plugin-km-kh-dist/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./*.md": "./*.md",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "*.md",
    "LICENSE"
  ],
  "keywords": [
    "open-lyric",
    "khmer",
    "km-KH",
    "cambodia",
    "spellcheck",
    "hunspell",
    "keyboard",
    "nida"
  ],
  "peerDependencies": {
    "open-lyric": "^0.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
